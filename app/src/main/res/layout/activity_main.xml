<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/root"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp">
        <!-- Cabeçalho: status em pílula, seletor IR | Wi-Fi e configurações -->
        <LinearLayout style="@style/Row" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/statusPill" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:layout_marginEnd="8dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp"
                android:background="@drawable/btn" android:stateListAnimator="@animator/press"
                android:contentDescription="Estado da conexão. Toque para reconectar">
                <View android:id="@+id/statusDot" android:layout_width="10dp" android:layout_height="10dp"
                    android:background="@drawable/dot" />
                <TextView android:id="@+id/statusLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:textColor="#E8ECF2" android:textSize="14sp"
                    android:singleLine="true" android:ellipsize="end" android:text="Iniciando…" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginEnd="8dp"
                android:orientation="horizontal" android:padding="4dp" android:background="@drawable/seg_bg">
                <TextView android:id="@+id/segIr" android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_ir" android:background="@drawable/seg_on"
                    android:textColor="#E8ECF2" android:textSize="14sp" android:text="IR" />
                <TextView android:id="@+id/segWifi" android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_wifi" android:background="@drawable/seg_on"
                    android:textColor="#E8ECF2" android:textSize="14sp" android:text="Wi-Fi" />
            </LinearLayout>
            <ImageButton android:id="@+id/settings" style="@style/RoundBtn" android:layout_width="52dp"
                android:layout_height="52dp" android:layout_margin="0dp" android:src="@drawable/ic_settings"
                android:contentDescription="Configurações" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="8dp" />
        <LinearLayout style="@style/Row" android:gravity="center_vertical">
            <ImageButton style="@style/RoundBtn" android:id="@+id/power" android:background="@drawable/btn_power"
                android:src="@drawable/ic_power" android:contentDescription="Ligar ou desligar" />
            <Button style="@style/LabelBtn" android:tag="KEY_SOURCE" android:drawableTop="@drawable/ic_input" android:text="Fonte" />
            <Button style="@style/LabelBtn" android:tag="KEY_MENU" android:drawableTop="@drawable/ic_menu" android:text="Menu" />
        </LinearLayout>
        <!-- Atalhos de apps: grade fixa 4 + 4 -->
        <LinearLayout android:id="@+id/apps1" style="@style/Row" android:layout_marginTop="4dp" />
        <LinearLayout android:id="@+id/apps2" style="@style/Row" />

        <!-- Direcional circular: anel com as setas e OK no centro -->
        <FrameLayout android:id="@+id/dpadBox" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipChildren="false">
        <FrameLayout android:id="@+id/dpad" android:layout_width="264dp" android:layout_height="264dp" android:layout_gravity="center"
            android:padding="4dp" android:background="@drawable/dpad_ring" android:elevation="6dp">
            <ImageButton style="@style/DpadBtn" android:layout_gravity="top|center_horizontal" android:tag="KEY_UP"
                android:src="@drawable/ic_up" android:contentDescription="Cima" />
            <ImageButton style="@style/DpadBtn" android:layout_gravity="bottom|center_horizontal" android:tag="KEY_DOWN"
                android:src="@drawable/ic_down" android:contentDescription="Baixo" />
            <ImageButton style="@style/DpadBtn" android:layout_gravity="start|center_vertical" android:tag="KEY_LEFT"
                android:src="@drawable/ic_left" android:contentDescription="Esquerda" />
            <ImageButton style="@style/DpadBtn" android:layout_gravity="end|center_vertical" android:tag="KEY_RIGHT"
                android:src="@drawable/ic_right" android:contentDescription="Direita" />
            <Button android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center"
                android:tag="KEY_ENTER" android:text="OK" android:textColor="#FFFFFF" android:textSize="20sp"
                android:textStyle="bold" android:background="@drawable/btn_ok" android:elevation="4dp"
                android:stateListAnimator="@animator/press" />
        </FrameLayout>
        </FrameLayout>

        <LinearLayout style="@style/Row">
            <Button style="@style/SmallBtn" android:tag="KEY_RETURN" android:drawableTop="@drawable/ic_back" android:text="Voltar" />
            <Button style="@style/SmallBtn" android:tag="KEY_HOME" android:drawableTop="@drawable/ic_home" android:text="Home" />
            <Button style="@style/SmallBtn" android:id="@+id/keyboard" android:drawableTop="@drawable/ic_keyboard" android:text="Teclado" />
            <Button style="@style/SmallBtn" android:id="@+id/voice" android:drawableTop="@drawable/ic_mic" android:text="Voz" />
            <Button style="@style/SmallBtn" android:tag="KEY_ENTER" android:drawableTop="@drawable/ic_enter" android:text="Enter" />
        </LinearLayout>

        <!-- Volume e canal em pílulas, como num controle físico -->
        <LinearLayout style="@style/Row" android:gravity="center_vertical">
            <LinearLayout style="@style/Pill">
                <ImageButton style="@style/PillBtn" android:tag="KEY_VOLUP" android:src="@drawable/ic_add" android:contentDescription="Aumentar volume" />
                <TextView style="@style/PillLabel" android:text="VOL" />
                <ImageButton style="@style/PillBtn" android:tag="KEY_VOLDOWN" android:src="@drawable/ic_remove" android:contentDescription="Diminuir volume" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageButton style="@style/RoundBtn" android:tag="KEY_MUTE" android:src="@drawable/ic_mute" android:contentDescription="Mudo" />
                <ImageButton style="@style/RoundBtn" android:id="@+id/dialpad" android:src="@drawable/ic_dialpad" android:contentDescription="Teclado numérico" />
            </LinearLayout>
            <LinearLayout style="@style/Pill">
                <ImageButton style="@style/PillBtn" android:tag="KEY_CHUP" android:src="@drawable/ic_ch_up" android:contentDescription="Próximo canal" />
                <TextView style="@style/PillLabel" android:text="CH" />
                <ImageButton style="@style/PillBtn" android:tag="KEY_CHDOWN" android:src="@drawable/ic_ch_down" android:contentDescription="Canal anterior" />
            </LinearLayout>
        </LinearLayout>

</LinearLayout>
    <!-- Aviso que aparece por alguns segundos e some -->
    <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_marginTop="70dp" android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" android:padding="14dp" android:background="@drawable/banner"
        android:elevation="12dp" android:textColor="#E8ECF2" android:textSize="14sp" android:visibility="gone" />
</FrameLayout>
