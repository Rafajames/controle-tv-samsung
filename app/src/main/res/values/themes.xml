<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#121418</item>
        <item name="android:statusBarColor">#121418</item>
        <item name="android:navigationBarColor">#121418</item>
    </style>
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Btn" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <!-- Botão com ícone em cima e rótulo pequeno embaixo -->
    <style name="LabelBtn" parent="Btn">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#B0BEC5</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:drawablePadding">2dp</item>
    </style>
    <!-- Linha de 5 botões pequenos (Voltar, Home, Teclado, Voz, Enter) -->
    <style name="SmallBtn" parent="LabelBtn">
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
    <!-- Botão redondo só com ícone -->
    <style name="RoundBtn">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/btn_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <!-- Botões pequenos nos cantos do direcional (mídia e touchpad) -->
    <style name="CornerBtn" parent="RoundBtn">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_margin">2dp</item>
    </style>
    <!-- Setas dentro do anel do direcional -->
    <style name="DpadBtn">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:background">@drawable/touch_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <!-- Metades de cima e de baixo das pílulas VOL/CH -->
    <style name="PillBtn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/touch_pill</item>
        <item name="android:scaleType">center</item>
    </style>
    <style name="PillLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#AEB8C2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
    <style name="Pill">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">136dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/pill</item>
    </style>
    <!-- ===== Redesenho por zonas: 2 formas, espaço de 8dp, textos de 13sp ===== -->
    <!-- Coluna lateral (esquerda/direita) com ícone + texto -->
    <style name="Key" parent="Btn">
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#E8ECF2</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>
    <!-- Coluna lateral só com ícone -->
    <style name="IconKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/btn</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <!-- Coluna do centro: círculo de 64dp (dentro de 72dp) -->
    <style name="RoundKey">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/btn_round</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <style name="RoundKeyText" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/btn_round</item>
        <item name="android:textColor">#E8ECF2</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <style name="SheetKey" parent="LabelBtn">
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#E8ECF2</item>
        <item name="android:paddingTop">12dp</item>
    </style>
    <style name="NumKey" parent="Btn">
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Gap">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">5dp</item>
    </style>
    <!-- ===== Visual cristal: botões redondos de vidro (cores em Theme.kt) ===== -->
    <style name="Glass">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <style name="GlassSmall" parent="Glass">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
    </style>
    <style name="GlassBig" parent="Glass">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
    </style>
    <style name="GlassSmallText" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>
    <style name="Seg">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
